<!DOCTYPE html>
<html lang="es" class="h-full bg-slate-950 text-slate-100 selection:bg-cyan-500 selection:text-slate-950">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Centro de Innovación Tecnológica - Aldeas Infantiles Argentina (Filial Mendoza)</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <!-- Canvas Confetti -->
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
          },
          colors: {
            aldeas: {
              blue: '#0099e5',
              cyan: '#00bcff',
              navy: '#0b2545',
              dark: '#031122'
            },
            accent: {
              purple: '#a855f7',
              pink: '#ec4899',
              amber: '#f59e0b',
              emerald: '#10b981',
              red: '#ef4444',
            }
          },
          animation: {
            'pulse-slow': 'pulse 3s cubic-bezier(0.4, 0, 0.6, 1) infinite',
            'bounce-short': 'bounce 1s infinite',
            'glow-pulse': 'glowPulse 2s infinite ease-in-out',
          },
          keyframes: {
            glowPulse: {
              '0%, 100%': { boxShadow: '0 0 15px rgba(0, 188, 255, 0.4)' },
              '50%': { boxShadow: '0 0 30px rgba(0, 188, 255, 0.8)' },
            }
          }
        }
      }
    }
  </script>

  <style>
    /* Custom Scrollbar */
    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-track { background: #031122; }
    ::-webkit-scrollbar-thumb { background: #1e293b; border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: #334155; }

    .glow-aldeas { box-shadow: 0 0 25px -5px rgba(0, 188, 255, 0.35); }
    .glow-purple { box-shadow: 0 0 25px -5px rgba(168, 85, 247, 0.35); }
    .glow-green { box-shadow: 0 0 25px -5px rgba(16, 185, 129, 0.35); }

    /* Glassmorphism */
    .glass-card {
      background: rgba(11, 37, 69, 0.7);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    /* Magnifier Lens Style */
    .magnifier-lens {
      pointer-events: none;
      position: absolute;
      border: 3px solid #00bcff;
      border-radius: 50%;
      box-shadow: 0 0 20px rgba(0, 188, 255, 0.6), inset 0 0 15px rgba(255, 255, 255, 0.3);
      background-repeat: no-repeat;
      display: none;
      z-index: 30;
    }

    /* Print styling for certificate */
    @media print {
      body * { visibility: hidden; }
      #printable-certificate, #printable-certificate * { visibility: visible; }
      #printable-certificate { position: absolute; left: 0; top: 0; width: 100%; color: black !important; background: white !important; }
    }
  </style>
</head>

<body class="h-full flex flex-col font-sans antialiased overflow-x-hidden bg-slate-950 text-slate-100 selection:bg-cyan-500">

  <header class="bg-slate-900/90 backdrop-blur-md border-b border-slate-800 sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex flex-wrap items-center justify-between gap-3">
      
      <!-- Institutional Logo & Title -->
      <div class="flex items-center space-x-3.5">
        <!-- Embedded SVG Official Logo Container with Upload Override Option -->
        <div class="relative group flex-shrink-0">
          <div id="logo-preview-box" class="w-12 h-12 sm:w-14 sm:h-14 bg-white rounded-2xl flex items-center justify-center p-1.5 shadow-lg shadow-cyan-500/20 overflow-hidden cursor-pointer border-2 border-cyan-400">
            <!-- EMBEDDED OFFICIAL ALDEAS INFANTILES SOS VECTOR LOGO -->
            <svg id="official-logo-svg" class="w-full h-full text-[#0099e5]" viewBox="0 0 200 240" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
              <path d="M 30,10 C 18,10 10,18 10,30 L 10,95 C 10,107 18,115 30,115 L 170,115 C 182,115 190,107 190,95 L 190,30 C 190,18 182,10 170,10 Z M 20,102 L 180,102 M 55,20 C 62,20 68,26 68,33 C 68,40 62,46 55,46 C 48,46 42,40 42,33 C 42,26 48,20 55,20 Z M 145,20 C 152,20 158,26 158,33 C 158,40 152,46 145,46 C 138,46 132,40 132,33 C 132,26 138,20 145,20 Z M 55,50 C 65,50 78,57 88,72 L 72,85 C 65,75 58,70 55,70 C 52,70 45,75 38,85 L 22,72 C 32,57 45,50 55,50 Z M 145,50 C 155,50 168,57 178,72 L 162,85 C 155,75 148,70 145,70 C 142,70 135,75 128,85 L 112,72 C 122,57 135,50 145,50 Z M 100,20 L 100,102 M 90,60 C 80,50 70,55 70,55 C 70,55 75,70 90,65 Z M 110,60 C 120,50 130,55 130,55 C 130,55 125,70 110,65 Z" fill-rule="evenodd"/>
              <!-- LOGO TYPOGRAPHY -->
              <text x="100" y="145" text-anchor="middle" font-family="'Plus Jakarta Sans', sans-serif" font-weight="900" font-size="28" fill="#0099e5">ALDEAS</text>
              <text x="100" y="175" text-anchor="middle" font-family="'Plus Jakarta Sans', sans-serif" font-weight="900" font-size="24" fill="#0099e5">INFANTILES</text>
              <text x="100" y="225" text-anchor="middle" font-family="'Plus Jakarta Sans', sans-serif" font-weight="900" font-size="52" fill="#0099e5">SOS</text>
            </svg>
            <img id="institutional-logo-img" src="" class="hidden w-full h-full object-contain" alt="Logo Reemplazado">
          </div>
          <!-- Upload overlay trigger -->
          <label for="logo-file-input" class="absolute inset-0 bg-slate-950/80 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity flex flex-col items-center justify-center cursor-pointer text-[9px] font-bold text-cyan-300 text-center p-1">
            <i data-lucide="upload" class="w-3.5 h-3.5 mb-0.5"></i>
            Cambiar
          </label>
          <input type="file" id="logo-file-input" accept="image/*" class="hidden" onchange="handleLogoUpload(event)">
        </div>

        <div>
          <div class="flex items-center flex-wrap gap-2">
            <h1 class="text-sm sm:text-base lg:text-lg font-black tracking-tight text-white leading-tight">
              Centro de Innovación Tecnológica
            </h1>
            <span class="px-2.5 py-0.5 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-[10px] sm:text-xs text-cyan-300 font-bold whitespace-nowrap">
              Aldeas Infantiles Argentina • Filial Mendoza
            </span>
          </div>
          <p class="text-xs text-slate-400 font-medium hidden sm:block">
            Taller Práctico de Prevención de Grooming y Perfiles Falsos con IA (60 min)
          </p>
        </div>
      </div>

      <!-- Controls: Timer, Mode & Settings -->
      <div class="flex items-center space-x-2 sm:space-x-3 ml-auto">
        
        <!-- Timer -->
        <div class="flex items-center space-x-2 bg-slate-950/80 px-3 py-1.5 rounded-xl border border-slate-800 text-xs">
          <i data-lucide="clock" class="w-4 h-4 text-cyan-400 animate-pulse"></i>
          <span class="hidden lg:inline text-slate-400 font-medium">Tiempo:</span>
          <span id="workshop-timer" class="font-mono font-bold text-cyan-300">00:00</span>
          <button onclick="toggleTimer()" class="text-slate-400 hover:text-white p-0.5" title="Pausar/Reanudar Reloj">
            <i data-lucide="pause" id="timer-icon" class="w-3.5 h-3.5"></i>
          </button>
        </div>

        <!-- Pause / Freeze Screen -->
        <button onclick="toggleFreezeMode()" class="flex items-center space-x-1.5 px-3 py-1.5 rounded-xl bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 text-xs font-bold border border-amber-500/30 transition-all">
          <i data-lucide="pause-circle" class="w-4 h-4"></i>
          <span class="hidden sm:inline">Pausar / Debate</span>
        </button>

        <!-- Audio Toggle -->
        <button id="audio-toggle" onclick="toggleAudio()" class="p-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 transition-colors" title="Sonido">
          <i data-lucide="volume-2" id="audio-icon" class="w-4 h-4"></i>
        </button>

        <!-- Teacher Notes Button -->
        <button onclick="toggleTeacherNotes()" class="p-2 sm:px-3 sm:py-1.5 rounded-xl bg-purple-500/10 hover:bg-purple-500/20 text-purple-300 text-xs font-bold border border-purple-500/30 transition-all">
          <i data-lucide="book-open" class="w-4 h-4 inline sm:mr-1"></i>
          <span class="hidden sm:inline">Guía Profe</span>
        </button>
      </div>

    </div>

    <!-- Desktop Tab Navigation -->
    <div class="border-t border-slate-800/80 bg-slate-950/80 hidden md:block">
      <div class="max-w-7xl mx-auto px-4 flex space-x-2 py-2 overflow-x-auto">
        <button onclick="switchTab('tab-challenge')" id="btn-tab-challenge" class="nav-tab active flex items-center space-x-2 px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all text-white bg-cyan-600 shadow-md">
          <i data-lucide="sparkles" class="w-4 h-4"></i>
          <span>1. Desafío Rostros IA (10m)</span>
        </button>
        <button onclick="switchTab('tab-builder')" id="btn-tab-builder" class="nav-tab flex items-center space-x-2 px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all text-slate-400 hover:text-white hover:bg-slate-800/60">
          <i data-lucide="user-plus" class="w-4 h-4"></i>
          <span>2. Perfil Falso (12m)</span>
        </button>
        <button onclick="switchTab('tab-chat')" id="btn-tab-chat" class="nav-tab flex items-center space-x-2 px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all text-slate-400 hover:text-white hover:bg-slate-800/60">
          <i data-lucide="message-square-warning" class="w-4 h-4"></i>
          <span>3. Chat & Red Flags (15m)</span>
        </button>
        <button onclick="switchTab('tab-scenarios')" id="btn-tab-scenarios" class="nav-tab flex items-center space-x-2 px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all text-slate-400 hover:text-white hover:bg-slate-800/60">
          <i data-lucide="gamepad-2" class="w-4 h-4"></i>
          <span>4. Casos de Estudio (12m)</span>
        </button>
        <button onclick="switchTab('tab-shield')" id="btn-tab-shield" class="nav-tab flex items-center space-x-2 px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all text-slate-400 hover:text-white hover:bg-slate-800/60">
          <i data-lucide="award" class="w-4 h-4"></i>
          <span>5. Certificado Digital (10m)</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Mobile Bottom Navigation Bar -->
  <div class="md:hidden bg-slate-900/95 border-t border-slate-800 fixed bottom-0 inset-x-0 z-50 px-2 py-2 flex justify-around backdrop-blur-md">
    <button onclick="switchTab('tab-challenge')" class="mobile-nav-btn p-2 rounded-xl text-cyan-400 flex flex-col items-center">
      <i data-lucide="sparkles" class="w-5 h-5"></i>
      <span class="text-[9px] mt-0.5 font-bold">1. Rostros</span>
    </button>
    <button onclick="switchTab('tab-builder')" class="mobile-nav-btn p-2 rounded-xl text-slate-400 flex flex-col items-center">
      <i data-lucide="user-plus" class="w-5 h-5"></i>
      <span class="text-[9px] mt-0.5 font-bold">2. Perfil</span>
    </button>
    <button onclick="switchTab('tab-chat')" class="mobile-nav-btn p-2 rounded-xl text-slate-400 flex flex-col items-center">
      <i data-lucide="message-square-warning" class="w-5 h-5"></i>
      <span class="text-[9px] mt-0.5 font-bold">3. Chat</span>
    </button>
    <button onclick="switchTab('tab-scenarios')" class="mobile-nav-btn p-2 rounded-xl text-slate-400 flex flex-col items-center">
      <i data-lucide="gamepad-2" class="w-5 h-5"></i>
      <span class="text-[9px] mt-0.5 font-bold">4. Casos</span>
    </button>
    <button onclick="switchTab('tab-shield')" class="mobile-nav-btn p-2 rounded-xl text-slate-400 flex flex-col items-center">
      <i data-lucide="award" class="w-5 h-5"></i>
      <span class="text-[9px] mt-0.5 font-bold">5. Certificado</span>
    </button>
  </div>

  <!-- Teacher Notes Bar -->
  <div id="teacher-notes" class="hidden bg-slate-900/95 border-b border-purple-500/30 px-4 py-3 text-xs sm:text-sm text-slate-300 relative z-40 backdrop-blur-md">
    <div class="max-w-7xl mx-auto flex items-start justify-between gap-3">
      <div class="flex items-start space-x-3">
        <i data-lucide="lightbulb" class="w-5 h-5 text-purple-400 mt-0.5 flex-shrink-0"></i>
        <div>
          <span class="font-bold text-purple-400">Guía Pedagógica Aldeas Infantiles Mendoza: </span>
          <span id="teacher-note-text">Inicia preguntando si alguna vez hablaron con un desconocido en Fortnite o Roblox. Muestra el temporizador para ajustar la dinámica a los 60 minutos.</span>
        </div>
      </div>
      <button onclick="toggleTeacherNotes()" class="text-slate-400 hover:text-white p-1">
        <i data-lucide="x" class="w-4 h-4"></i>
      </button>
    </div>
  </div>

  <!-- Freeze Screen Overlay (Modo Debate) -->
  <div id="freeze-overlay" class="hidden fixed inset-0 bg-slate-950/95 z-50 backdrop-blur-xl flex flex-col items-center justify-center p-6 text-center animate-fadeIn">
    <div class="p-5 bg-amber-500/20 text-amber-400 rounded-full border border-amber-500/30 mb-4 animate-bounce">
      <i data-lucide="pause-circle" class="w-12 h-12"></i>
    </div>
    <h2 class="text-2xl sm:text-4xl font-black text-white">MODO DEBATE Y REFLEXIÓN EN EL AULA</h2>
    <p class="mt-3 text-slate-300 max-w-xl text-sm sm:text-base leading-relaxed">
      El equipo del Centro de Innovación Tecnológica ha pausado la pantalla. Miren al frente para conversar sobre lo observado antes de continuar.
    </p>
    <button onclick="toggleFreezeMode()" class="mt-6 px-8 py-3.5 rounded-2xl bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold text-sm shadow-xl transition-transform active:scale-95">
      Reanudar Taller
    </button>
  </div>

  <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 lg:p-8 pb-24 md:pb-8">

    <!-- MODULE 1: AI PHOTO CHALLENGE -->
    <section id="tab-challenge" class="tab-content block space-y-6">
      <div class="bg-gradient-to-r from-slate-900 via-aldeas-navy to-slate-900 border border-slate-800 rounded-3xl p-6 sm:p-8 relative overflow-hidden">
        <div class="max-w-3xl">
          <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-semibold mb-3">
            <i data-lucide="sparkles" class="w-3.5 h-3.5"></i>
            <span>Módulo 1 (10 - 12 minutos)</span>
          </div>
          <h2 class="text-2xl sm:text-4xl font-black text-white tracking-tight">
            Desafío CiberDetective: ¿Real o Inteligencia Artificial?
          </h2>
          <p class="mt-2 text-slate-300 text-sm sm:text-base leading-relaxed">
            Observa atentamente a estas 4 personas que solicitaron amistad. Vota en clase si crees que son reales. Luego utiliza la <strong class="text-cyan-300">"Lupa Inspectora"</strong> para analizar las fallas que comete la IA en los ojos, cabello y fondos.
          </p>
        </div>
      </div>

      <!-- Photo Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6" id="ai-photo-grid">
        <!-- JS rendered -->
      </div>

      <!-- Magnifier Inspection Tool -->
      <div id="inspector-modal" class="hidden glass-card rounded-3xl p-6 border-2 border-cyan-500/40 space-y-4">
        <div class="flex items-center justify-between border-b border-slate-800 pb-3">
          <div class="flex items-center space-x-2 text-cyan-300">
            <i data-lucide="search" class="w-5 h-5"></i>
            <h3 class="font-bold text-white text-base">Lupa Inspectora de Artefactos IA</h3>
          </div>
          <button onclick="closeInspector()" class="text-slate-400 hover:text-white p-1">
            <i data-lucide="x" class="w-5 h-5"></i>
          </button>
        </div>
        <p class="text-xs text-slate-300">Mueve el cursor o toque de pantalla sobre la imagen para ampliar los detalles sospechosos:</p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-center">
          <div class="relative overflow-hidden rounded-2xl bg-slate-950 border border-slate-800 mx-auto max-w-sm cursor-crosshair" id="magnifier-container">
            <img id="inspector-img" src="" class="w-full h-80 object-cover">
            <div id="magnifier-lens" class="magnifier-lens"></div>
          </div>
          <div class="space-y-3 bg-slate-950/80 p-5 rounded-2xl border border-slate-800">
            <h4 class="text-sm font-bold text-amber-400 flex items-center gap-1.5">
              <i data-lucide="alert-triangle" class="w-4 h-4"></i>
              Fallas típicas detectadas en este rostro:
            </h4>
            <ul id="inspector-clues-list" class="space-y-2 text-xs text-slate-300 list-disc list-inside">
              <!-- JS populated -->
            </ul>
          </div>
        </div>
      </div>

      <!-- Grand Reveal Card -->
      <div id="ai-reveal-card" class="hidden bg-gradient-to-br from-aldeas-navy via-slate-900 to-indigo-950/80 border-2 border-cyan-500/50 rounded-3xl p-6 sm:p-8 glow-aldeas transition-all duration-500">
        <div class="flex flex-col md:flex-row items-center justify-between gap-6">
          <div class="space-y-3 text-center md:text-left">
            <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-red-500/20 border border-red-500/30 text-red-400 text-xs font-bold">
              <i data-lucide="alert-circle" class="w-4 h-4"></i>
              <span>REVELACIÓN CLAVE DEL TALLER</span>
            </div>
            <h3 class="text-2xl sm:text-3xl font-black text-white">
              ¡ABSOLUTAMENTE TODOS SON FALSOS! 🤖
            </h3>
            <p class="text-slate-300 text-sm sm:text-base max-w-2xl">
              Cualquier foto de perfil en redes sociales o videojuegos puede ser generada en menos de 2 minutos por Inteligencia Artificial. <strong class="text-cyan-300">Una cara simpática o real nunca garantiza la identidad de quien está al otro lado.</strong>
            </p>
          </div>
          <button onclick="switchTab('tab-builder')" class="px-6 py-4 rounded-2xl bg-gradient-to-r from-aldeas-blue to-cyan-500 hover:from-cyan-500 hover:to-aldeas-blue text-white font-bold text-sm shadow-xl flex items-center justify-center space-x-2 transition-transform active:scale-95 whitespace-nowrap">
            <span>Módulo 2: Crear Perfil Falso</span>
            <i data-lucide="arrow-right" class="w-4 h-4"></i>
          </button>
        </div>
      </div>
    </section>

    <!-- MODULE 2: PROFILE BUILDER -->
    <section id="tab-builder" class="tab-content hidden space-y-6">
      <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 sm:p-8">
        <div class="max-w-3xl">
          <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-purple-500/10 border border-purple-500/20 text-purple-400 text-xs font-semibold mb-3">
            <i data-lucide="cpu" class="w-3.5 h-3.5"></i>
            <span>Módulo 2 (12 - 15 minutos)</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-black text-white">
            Simulador de Fabricación de Perfiles Falsos
          </h2>
          <p class="mt-2 text-slate-300 text-sm sm:text-base">
            Construyan en grupo el perfil de un usuario ficticio. Observen cómo agregar "Amigos en común" o "Pases de juegos" dispara el <strong class="text-purple-400">Medidor de Falsa Credibilidad</strong>.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <!-- Controls Left -->
        <div class="lg:col-span-7 space-y-5">
          <!-- Step 1: Face -->
          <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 space-y-3">
            <label class="text-xs font-bold uppercase tracking-wider text-cyan-400">1. Seleccionar Rostro de IA</label>
            <div class="grid grid-cols-4 gap-3" id="builder-avatar-select"></div>
          </div>

          <!-- Step 2: Identity -->
          <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 space-y-3">
            <label class="text-xs font-bold uppercase tracking-wider text-purple-400">2. Identidad Ficticia</label>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-2" id="builder-identity-select"></div>
          </div>

          <!-- Step 3: Interests -->
          <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 space-y-3">
            <label class="text-xs font-bold uppercase tracking-wider text-emerald-400">3. Gustos y "Anzuelos"</label>
            <div class="flex flex-wrap gap-2" id="builder-interests-select"></div>
          </div>

          <!-- Step 4: Fake Mutual Friends -->
          <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 space-y-3">
            <label class="text-xs font-bold uppercase tracking-wider text-amber-400">4. Trampa de Amigos en Común</label>
            <div class="flex items-center space-x-3">
              <input type="checkbox" id="chk-mutual-friends" onchange="toggleMutualFriends()" class="w-5 h-5 rounded bg-slate-950 border-slate-800 text-cyan-500 focus:ring-0 cursor-pointer">
              <label for="chk-mutual-friends" class="text-xs text-slate-300 cursor-pointer font-medium">
                Poner en la bio: "Amigo de chicos de Mendoza" (+30% Credibilidad)
              </label>
            </div>
          </div>

          <!-- Step 5: Fake Posts -->
          <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 space-y-3">
            <label class="text-xs font-bold uppercase tracking-wider text-pink-400">5. Fotos Robadas para el Muro</label>
            <div class="grid grid-cols-3 gap-2" id="builder-posts-select"></div>
          </div>
        </div>

        <!-- Preview Right -->
        <div class="lg:col-span-5 sticky top-20">
          <div class="bg-slate-900 border-2 border-cyan-500/30 rounded-3xl p-5 shadow-2xl space-y-4 glow-aldeas">
            
            <!-- Live Credibility Meter -->
