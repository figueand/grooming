    function initMagnifier() {
      const img = document.getElementById('inspector-img');
      const lens = document.getElementById('magnifier-lens');
      const container = document.getElementById('magnifier-container');

      lens.style.backgroundImage = `url('${img.src}')`;
      lens.style.backgroundSize = `${img.width * 2.5}px ${img.height * 2.5}px`;

      const zoom = 2.5;
      container.onmousemove = function(e) {
        lens.style.display = 'block';
        const rect = container.getBoundingClientRect();
        let x = e.clientX - rect.left;
        let y = e.clientY - rect.top;
        const lensW = 100, lensH = 100;

        lens.style.width = lensW + 'px';
        lens.style.height = lensH + 'px';
        lens.style.left = (x - lensW / 2) + 'px';
        lens.style.top = (y - lensH / 2) + 'px';
        lens.style.backgroundPosition = `-${(x * zoom) - lensW / 2}px -${(y * zoom) - lensH / 2}px`;
      };

      container.onmouseleave = function() {
        lens.style.display = 'none';
      };
    }

